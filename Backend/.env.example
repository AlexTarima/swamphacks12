# Copy to .env and configure credentials there. Never commit real credentials.
PLANIT_DATABASE_PATH=./data/runtime/sites.db
PLANIT_UPLOAD_DIR=./data/runtime/photos
PLANIT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PLANIT_BACKGROUND_REFRESH=1
PLANIT_REFRESH_SECONDS=300
PLANIT_LIGHTNING_SECONDS=30
PLANIT_STRIKE_SECONDS=15
PLANIT_HEFS_SECONDS=900
PLANIT_WRITE_TOKEN=
# auto selects Xweather when its credentials are present, otherwise Weather Company.
PLANIT_LIGHTNING_PROVIDER=auto
# Xweather combined client_id_client_secret. Alternatively set the separate pair.
PLANIT_XWEATHER_API_KEY=
PLANIT_XWEATHER_CLIENT_ID=
PLANIT_XWEATHER_CLIENT_SECRET=
# Weather Company only; do not put an Xweather credential here.
PLANIT_LIGHTNING_API_KEY=
PLANIT_ML_URL=
PLANIT_ML_TOKEN=
PLANIT_ML_MODEL_VERSION=
PORT=8000
